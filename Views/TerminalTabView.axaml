<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terminal="using:KiteShell.Terminal"
             x:Class="KiteShell.Views.TerminalTabView">
    <Grid x:Name="RootGrid" ColumnDefinitions="*,0,0">
        <Grid Grid.Column="0" RowDefinitions="*,Auto,30">
            <Grid Grid.Row="0">
                <terminal:TerminalControl x:Name="Terminal" />

                <Border x:Name="ConnectingOverlay"
                        IsVisible="False"
                        Background="#EA0E1118">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                        <TextBlock x:Name="ConnectingText" Text="正在建立 SSH 连接..." FontSize="12" HorizontalAlignment="Center" />
                        <Button Content="取消" Click="OnCancelConnectClick" HorizontalAlignment="Center" MinWidth="80" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="DisconnectedBanner"
                    Grid.Row="1"
                    Margin="10,6,10,0"
                    Padding="12,6"
                    CornerRadius="6"
                    Background="#E6A32A22"
                    IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="DisconnectedText"
                               Foreground="#FFD7D7"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="flat"
                            Content="重新连接"
                            Foreground="White"
                            Click="OnReconnectClick" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#151924"
                    BorderBrush="#232A38"
                    BorderThickness="0,1,0,0"
                    Padding="8,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#8B94A7" />
                        <TextBlock x:Name="StateText" Text="未连接" FontSize="11" Foreground="#8B94A7" />
                        <Border Width="1" Height="12" Background="#232A38" Margin="4,0" />
                        <TextBlock x:Name="SizeText" Text="80 × 24" FontSize="10" Classes="mono" Foreground="#6B7488" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="SftpButton" Classes="flat" Content="SFTP" Click="OnToggleSftpClick" ToolTip.Tip="打开 SFTP 文件面板（支持拖拽上传）" />
                        <Button x:Name="ReconnectButton" Classes="flat" Content="重连" Click="OnReconnectClick" />
                        <Button Classes="flat" Content="清屏" Click="OnClearClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="SftpSplitter"
                      Grid.Column="1"
                      Width="0"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <Border x:Name="SftpPanel"
                Grid.Column="2"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <Grid Grid.Row="0" Margin="12,10,8,6" ColumnDefinitions="Auto,*,Auto,Auto">
                    <PathIcon Data="{StaticResource IconSftp}" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Column="1" Text="SFTP 文件" Margin="8,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="icon tiny" Click="OnSftpRefreshClick" ToolTip.Tip="刷新">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon tiny" Click="OnSftpCloseClick" ToolTip.Tip="关闭面板">
                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="10,0,10,8" ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Classes="icon tiny" Click="OnSftpUpClick" ToolTip.Tip="上级目录">
                        <PathIcon Data="{StaticResource IconArrowUp}" Width="14" Height="14" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon tiny" Click="OnSftpRefreshClick" ToolTip.Tip="刷新">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                    </Button>
                    <TextBox x:Name="SftpPathBox"
                             Grid.Column="2"
                             Margin="6,0"
                             MinHeight="28"
                             FontSize="11"
                             FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace"
                             KeyDown="OnSftpPathKeyDown" />
                    <Button Grid.Column="3" Classes="accent" Content="转到" Padding="10,4" Click="OnSftpGoClick" />
                </Grid>

                <ProgressBar x:Name="SftpProgress" Grid.Row="2" IsIndeterminate="True" Height="2" IsVisible="False" />

                <Grid Grid.Row="3"
                      RowDefinitions="Auto,*"
                      ToolTip.Tip="可从文件管理器拖拽文件或文件夹到此处上传">
                    <Border Background="#121620" BorderBrush="#232A38" BorderThickness="0,1,0,1" Padding="10,5">
                        <Grid ColumnDefinitions="*,80,118">
                            <TextBlock Text="名称" FontSize="10" Foreground="#8B94A7" />
                            <TextBlock Grid.Column="1" Text="大小" FontSize="10" Foreground="#8B94A7" />
                            <TextBlock Grid.Column="2" Text="修改时间" FontSize="10" Foreground="#8B94A7" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="SftpList"
                             Grid.Row="1"
                             SelectionMode="Multiple"
                             DoubleTapped="OnSftpListDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,80,118" Height="26" Margin="10,0,2,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Panel VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconFolder}"
                                                      Width="14"
                                                      Height="14"
                                                      IsVisible="{Binding IsDirectory}"
                                                      Foreground="#E5C07B" />
                                            <PathIcon Data="{StaticResource IconFile}"
                                                      Width="14"
                                                      Height="14"
                                                      IsVisible="{Binding !IsDirectory}"
                                                      Foreground="#8B94A7" />
                                        </Panel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="6,0,0,0"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               FontSize="10.5"
                                               Foreground="#8B94A7"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ModifiedText}"
                                               FontSize="10.5"
                                               Foreground="#8B94A7"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="下载" Click="OnSftpDownloadClick" />
                                <MenuItem Header="重命名" Click="OnSftpRenameClick" />
                                <Separator />
                                <MenuItem Header="删除" Click="OnSftpDeleteClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Border x:Name="SftpDropOverlay"
                            Grid.RowSpan="2"
                            Margin="6"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Background="#F20E1118"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="9"
                                    MaxWidth="280">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="12"
                                    Background="#334C8DFF"
                                    HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconUpload}"
                                          Width="24"
                                          Height="24"
                                          Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="松开鼠标上传"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SftpDropText"
                                       FontSize="10.5"
                                       Classes="muted"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="支持文件与文件夹，远端目录会自动创建"
                                       FontSize="9.5"
                                       Foreground="#6B7488"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" BorderBrush="#232A38" BorderThickness="0,1,0,0" Padding="6,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button Classes="icon tiny" Click="OnSftpUploadClick" ToolTip.Tip="上传文件（也可直接拖拽文件/文件夹）">
                                <PathIcon Data="{StaticResource IconUpload}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="icon tiny" Click="OnSftpDownloadClick" ToolTip.Tip="下载所选">
                                <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="icon tiny" Click="OnSftpNewFolderClick" ToolTip.Tip="新建目录">
                                <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="icon tiny" Click="OnSftpRenameClick" ToolTip.Tip="重命名">
                                <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
                            </Button>
                            <Button Classes="icon tiny" Click="OnSftpDeleteClick" ToolTip.Tip="删除">
                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="SftpStatusText"
                                   Grid.Column="1"
                                   Margin="8,0"
                                   FontSize="10"
                                   Foreground="#8B94A7"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SftpPathHint"
                                   Grid.Column="2"
                                   FontSize="10"
                                   Foreground="#6B7488"
                                   VerticalAlignment="Center"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
