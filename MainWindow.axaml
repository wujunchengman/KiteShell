<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KiteShell.ViewModels"
        xmlns:models="using:KiteShell.Models"
        mc:Ignorable="d"
        x:Class="KiteShell.MainWindow"
        d:DesignWidth="1360"
        d:DesignHeight="840"
        Title="KiteShell"
        Width="1360"
        Height="840"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
    <Grid RowDefinitions="56,*,24">
        <!-- 顶栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <PathIcon Data="{StaticResource IconTerminal}" Width="18" Height="18" Foreground="White" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="KiteShell" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="SSH 会话与文件管理" FontSize="10" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBox x:Name="QuickHostBox"
                                 Width="190"
                                 MinHeight="30"
                                 PlaceholderText="主机地址"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="11.5"
                                 KeyDown="OnQuickConnectKeyDown" />
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="2,4" />
                        <TextBox x:Name="QuickUserBox"
                                 Width="110"
                                 MinHeight="30"
                                 PlaceholderText="用户名"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="11.5"
                                 KeyDown="OnQuickConnectKeyDown" />
                        <TextBox x:Name="QuickPortBox"
                                 Width="52"
                                 MinHeight="30"
                                 Text="22"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="11.5"
                                 KeyDown="OnQuickConnectKeyDown" />
                        <Button Classes="accent" Content="连接" Padding="14,4" Click="OnQuickConnectClick" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="icon" Click="OnNewSessionClick" ToolTip.Tip="新建会话（Ctrl+Shift+N）">
                        <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" Click="OnNewFolderClick" ToolTip.Tip="新建分组">
                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="282,4,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Margin="14,14,10,8" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Text="会话" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource CardBrush}"
                                CornerRadius="9"
                                Padding="7,1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="SessionCountText" Text="0" FontSize="10" Classes="muted" />
                        </Border>
                        <Button Grid.Column="2" Classes="icon tiny" Click="OnNewSessionClick" ToolTip.Tip="新建会话">
                            <PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" />
                        </Button>
                        <Button Grid.Column="3" Classes="icon tiny" Click="OnNewFolderClick" ToolTip.Tip="新建分组">
                            <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="SessionSearchBox"
                             Grid.Row="1"
                             Margin="12,0,12,8"
                             MinHeight="30"
                             PlaceholderText="搜索会话、主机或分组..."
                             TextChanged="OnSessionSearchChanged" />

                    <TreeView x:Name="SessionTree"
                              Grid.Row="2"
                              Margin="6,0,6,6"
                              SelectionChanged="OnSessionSelectionChanged"
                              DoubleTapped="OnSessionTreeDoubleTapped"
                              PointerPressed="OnSessionTreePointerPressed">
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="SessionContextMenu">
                                <MenuItem Header="连接" Click="OnContextConnectClick" />
                                <Separator />
                                <MenuItem Header="新建会话" Click="OnContextNewSessionClick" />
                                <MenuItem Header="新建分组" Click="OnContextNewFolderClick" />
                                <MenuItem Header="从 ~/.ssh/config 导入" Click="OnImportSshConfigClick" />
                                <Separator />
                                <MenuItem Header="编辑 / 重命名" Click="OnContextEditClick" />
                                <MenuItem Header="复制会话" Click="OnContextDuplicateClick" />
                                <Separator />
                                <MenuItem Header="删除" Click="OnContextDeleteClick" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:SessionNodeViewModel" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Height="30" ToolTip.Tip="{Binding Subtitle}">
                                    <Panel VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconFolder}"
                                                  Width="14"
                                                  Height="14"
                                                  IsVisible="{Binding IsFolder}"
                                                  Foreground="{Binding AccentBrush}" />
                                        <PathIcon Data="{StaticResource IconServer}"
                                                  Width="14"
                                                  Height="14"
                                                  IsVisible="{Binding !IsFolder}"
                                                  Foreground="{Binding AccentBrush}" />
                                    </Panel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Margin="8,0,4,0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Subtitle}"
                                               IsVisible="{Binding !IsFolder}"
                                               FontSize="9.5"
                                               Classes="muted"
                                               Margin="4,0,6,0"
                                               VerticalAlignment="Center"
                                               MaxWidth="108"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,8,10,8">
                        <Grid RowDefinitions="Auto,150" RowSpacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <PathIcon Data="{StaticResource IconSnippet}" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="快捷命令"
                                           Margin="7,0,0,0"
                                           FontSize="11"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="icon tiny" Click="OnAddSnippetClick" ToolTip.Tip="添加快捷命令">
                                    <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                                </Button>
                                <Button Grid.Column="3" Classes="icon tiny" Click="OnDeleteSnippetClick" ToolTip.Tip="删除所选快捷命令">
                                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                </Button>
                            </Grid>
                            <ListBox x:Name="SnippetList"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     DoubleTapped="OnSnippetDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Snippet">
                                        <StackPanel Spacing="1" Margin="2,2">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Command}"
                                                       FontSize="10"
                                                       Classes="mono"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <Grid Grid.Column="2" Background="{DynamicResource AppBgBrush}">
                <TabControl x:Name="SessionTabs"
                            Background="Transparent"
                            SelectionChanged="OnTabSelectionChanged" />

                <Grid x:Name="WelcomePanel" Background="{DynamicResource AppBgBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="620">
                        <Border Width="66" Height="66" CornerRadius="18" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconTerminal}" Width="33" Height="33" Foreground="White" />
                        </Border>
                        <StackPanel Spacing="5">
                            <TextBlock Text="KiteShell" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="轻量的 SSH 会话管理与终端" Classes="muted" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Classes="accent" Content="新建 SSH 会话" Click="OnNewSessionClick" />
                            <Button Content="新建分组" Click="OnNewFolderClick" />
                        </StackPanel>
                        <Border Classes="card" Padding="18">
                            <StackPanel Spacing="9">
                                <TextBlock Text="快速开始" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="• 双击左侧会话即可打开终端，支持多标签与断线重连。"
                                           Classes="muted"
                                           FontSize="11.5" />
                                <TextBlock Text="• 终端支持 256 色 / TrueColor、滚动历史、选区复制与中文宽字符。"
                                           Classes="muted"
                                           FontSize="11.5" />
                                <TextBlock Text="• 连接后点击终端底部 SFTP 按钮，可浏览、上传、下载远端文件。"
                                           Classes="muted"
                                           FontSize="11.5" />
                                <TextBlock Text="• 首次连接会校验主机指纹；保存的密码使用本机密钥加密。"
                                           Classes="muted"
                                           FontSize="11.5" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="提示：Ctrl+Shift+C / V 复制粘贴，Ctrl+Shift+N 新建会话，Ctrl+Shift+W 关闭标签。"
                                   Classes="muted"
                                   FontSize="10.5"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="10.5" Classes="muted" />
                </StackPanel>
                <TextBlock x:Name="SessionHintText"
                           Grid.Column="1"
                           FontSize="10.5"
                           Classes="muted"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusRightText"
                           Grid.Column="2"
                           Text="KiteShell"
                           FontSize="10.5"
                           Classes="muted" />
            </Grid>
        </Border>
    </Grid>
</Window>
